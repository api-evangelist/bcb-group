        {
          "info": {
            "name": "Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bcb.group/v3/accounts/:accountId/transactions",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
